<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "theme.music">
<!ENTITY author    "deltrivx">
<!ENTITY version   "2026.07.31m">
		<!ENTITY launch    "Settings/ThemeMusic">
		<!ENTITY plugdir   "/usr/local/emhttp/plugins/&name;">
		<!ENTITY flash     "/boot/config/plugins/&name;">
		<!ENTITY github    "deltrivx/ThemeMusic">
		<!ENTITY pluginURL "https://raw.githubusercontent.com/&github;/main/theme.music.plg">
		<!ENTITY installSH "https://raw.githubusercontent.com/&github;/main/scripts/install.sh">
		<!ENTITY ver       "v1.0.15">
		]>
		<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="6.12.0" icon="music" support="https://github.com/&github;">
		
		<!-- CHANGES in CDATA: bare & in notes must not break simplexml_load_file -->
		<CHANGES>
		<![CDATA[
		## Theme Music
			###2026.07.31k
			- v1.0.13: status row info icon vertically aligned with source/tip text
			###2026.07.31j
			- v1.0.12: stable list/lyrics height; distinct rescan/lyric icons; status info+source+tip
			###2026.07.31i
			- v1.0.11: local lib search/rescan; scan truncate tip (2000); lyric re-fetch; cache clear in settings
			###2026.07.31h
			- v1.0.10: left pane fixed width; right list/lyrics fills residual (no 280 blank strip)
			###2026.07.31g
			- v1.0.9: card width 100% of db_box column (2/3-col); tbody.sortable host like system tiles
			###2026.07.31f
			- v1.0.8: fitRightPane uses list-item font metrics; avoid max-content self-lock under 280 cap
			###2026.07.31e
			- v1.0.7: dynamic right pane width (cap 280); server-side dash position memory
			###2026.07.31d
			- v1.0.6: empty/unconfigured tip only under volume status (no duplicate under title)
			###2026.07.31b
			- v1.0.5: boot restore-from-flash before OTA (official package; survive reboot offline/timeout)
			###2026.07.31a
			- boot: restore runtime from flash before OTA (survive reboot when GitHub times out)
			###2026.07.30e
			- v1.0.4: reject mismatched sidecar LRC; stricter lrclib/netease match; quarantine bad lyrics
			###2026.07.30d
			- v1.0.3: lyric clock aligned to ThemeEffects beta (floor*1000 - offset; no fixed lead)
			###2026.07.30c
			- v1.0.2: list/lyrics toggle unclipped; rAF lyric sync + LRC offset fix
			###2026.07.30a
			- v1.0.1: dual-pane gap; active-only lyric marquee; dash pos persist; mobile apply/done center
			###2026.07.30
			- v1.0.0 stable: music source first + local-dir hideRow; PC/mobile profiles; run modes; tab-hide pause
			###2026.07.30i
			- v1.0.0-Beta9: PC/mobile separate run mode + playback defaults; pause on tab hide
			###2026.07.30h
			- v1.0.0-Beta8: run mode card/chip/both; remove play-range; SERVICE master switch
			###2026.07.30g
			- v1.0.0-Beta7: cross-page resume/mobile progress recovery; FLAC stall hard-reset
			###2026.07.30f
			- v1.0.0-Beta6: card dual-pane fixed widths; wider list/lyrics rail; tighter L-R gap
			###2026.07.30e
		- v1.0.0-Beta5: title 主题音乐 + title runtime switch; remove dual-install warn/music subtitle; uniform control column
		###2026.07.30d
		- v1.0.0-Beta4: uniform settings control column; sitewide chip vs ThemeEffects cfg isolation
		###2026.07.30c
		- v1.0.0-Beta3: content-sized selects, fileTree path align, independent update UI
		- remove save tip under title; theme-music-update.php + settings.js
		###2026.07.30b
		- v1.0.0-Beta2: settings page Unraid markdown form (dt/dd) aligned with ThemeEffects
		- Apply button unlock on form change (BodyInlineJS + class=lock)
		- theme-music-settings.css path-field widths; install.sh OTA includes settings CSS
		###2026.07.30a
		- v1.0.0-Beta1: standalone Unraid music plugin (dashboard card + sitewide chip)
		- Local library (mp3/flac/m4a…), LRC lyrics, cover cache, cross-page resume (best-effort)
		- Independent of ThemeEffects; do not enable music on both plugins at once
		]]>
		</CHANGES>

<!-- Prepare dirs -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p &flash;/assets &plugdir;/assets
echo "Theme Music: preparing &name;…"
exit 0
</INLINE>
</FILE>

<!-- README shown in plugin manager -->
<FILE Name="&plugdir;/README.md">
<INLINE>
<![CDATA[
**主题音乐（Theme Music）**
				## v1.0.0-Beta9 - 2026-07-30
				
				### 概述
				
				**主题音乐**独立插件。从 ThemeEffects 抽取音乐组件，以 `theme.music` 发布；路径、配置、缓存与主题特效完全分离。
				
				### Beta9 变更
				
				- 电脑/手机分设运行模式与音量、自动播放、随机、循环
				- 手机默认「和电脑端配置相同」；划掉标签页暂停播放
				
				### Beta8 变更
				
				- 运行模式三选项；取消播放范围；标题后总开关
			]]>
</INLINE>
</FILE>

<!-- Boot/install: restore runtime from flash first (offline-safe), then OTA if network works -->
<FILE Name="/tmp/theme-music-install.sh" Run="/bin/bash">
<INLINE>
#!/bin/bash
# Never hard-fail boot when flash already has a package (reboot offline / GitHub timeout).
set +e
export PATH="/usr/local/sbin:/usr/sbin:/sbin:/usr/local/bin:/usr/bin:/bin"
FLASH="&flash;"
PLUG="&plugdir;"
mkdir -p "$FLASH/assets" "$PLUG/assets"

restore_from_flash() {
  [ -f "$FLASH/ThemeMusic.page" ] || return 1
  [ -f "$FLASH/ucwc-music-api.php" ] || return 1
  echo "Theme Music: restoring runtime from flash…"
  for f in ThemeMusic.page ThemeMusic_Loader.page ucwc-music-api.php theme-music-save.php theme-music-update.php; do
    [ -f "$FLASH/$f" ] &amp;&amp; install -m 0644 "$FLASH/$f" "$PLUG/$f"
  done
  for f in ucwc-music.js ucwc-music.css theme-music-settings.js theme-music-settings.css; do
    [ -f "$FLASH/assets/$f" ] &amp;&amp; install -m 0644 "$FLASH/assets/$f" "$PLUG/assets/$f"
  done
  return 0
}

if restore_from_flash; then
  echo "Theme Music: flash restore OK"
else
  echo "Theme Music: no complete flash package yet; will need network install"
fi

URL="&installSH;"
OUT="/tmp/theme-music-install-run.sh"
echo "Theme Music: fetching install.sh for OTA &ver;…"
ok=0
if curl -4 -fsSL --http1.1 --connect-timeout 12 --max-time 45 --retry 2 -o "$OUT" "$URL"; then
  ok=1
else
  for m in \
    "https://cdn.jsdelivr.net/gh/&github;@main/scripts/install.sh" \
    "https://fastly.jsdelivr.net/gh/&github;@main/scripts/install.sh" \
    "https://raw.gitmirror.com/&github;/main/scripts/install.sh" \
    "https://ghfast.top/https://raw.githubusercontent.com/&github;/main/scripts/install.sh"
  do
    if curl -4 -fsSL --http1.1 --connect-timeout 12 --max-time 45 --retry 1 -o "$OUT" "$m"; then ok=1; break; fi
  done
fi

if [ "$ok" = "1" ] &amp;&amp; [ -s "$OUT" ]; then
  chmod +x "$OUT"
  export UCWC_PLUGIN_INSTALL=1
  # Prefer line-buffered progress for plugin manager
  if command -v stdbuf >/dev/null 2>&amp;1; then
    stdbuf -oL -eL sh "$OUT" install "&ver;" ota
  else
    sh "$OUT" install "&ver;" ota
  fi
  rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "Theme Music: OTA install OK (&ver;)"
    exit 0
  fi
  echo "Theme Music: OTA returned $rc — falling back to flash restore"
  restore_from_flash
else
  echo "Theme Music: cannot download install.sh (network)"
fi

if [ -f "$PLUG/ThemeMusic.page" ] &amp;&amp; [ -f "$PLUG/ucwc-music-api.php" ]; then
  echo "Theme Music: runtime present after offline/OTA path — boot OK"
  exit 0
fi
echo "Theme Music: ERROR — no runtime files (flash empty and network failed)" >&amp;2
exit 1
</INLINE>
</FILE>

<!-- remove -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
#!/bin/bash
SH="/tmp/theme-music-install-run.sh"
if [ ! -f "$SH" ]; then
  curl -4 -fsSL --http1.1 -o "$SH" "&installSH;" 2>/dev/null || true
fi
if [ -f "$SH" ]; then
  chmod +x "$SH" 2>/dev/null || true
  bash -c "source '$SH'; uninstall_plugin" 2>/dev/null || true
fi
rm -f /tmp/theme-music-install.sh /tmp/theme-music-install-run.sh
exit 0
</INLINE>
</FILE>

</PLUGIN>
