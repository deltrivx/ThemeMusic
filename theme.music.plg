<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "theme.music">
<!ENTITY author    "deltrivx">
<!ENTITY version   "v1.0.19">
		<!ENTITY launch    "Settings/ThemeMusic">
		<!ENTITY plugdir   "/usr/local/emhttp/plugins/&name;">
		<!ENTITY flash     "/boot/config/plugins/&name;">
		<!ENTITY github    "deltrivx/ThemeMusic">
		<!ENTITY pluginURL "https://raw.githubusercontent.com/&github;/main/theme.music.plg">
		<!ENTITY installSH "https://raw.githubusercontent.com/&github;/main/scripts/install.sh">
		<!ENTITY ver       "v1.0.19">
		]>
		<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="6.12.0" icon="music" support="https://github.com/&github;">
		
		<!-- CHANGES in CDATA: bare & in notes must not break simplexml_load_file -->
		<CHANGES>
		<![CDATA[
		## Theme Music
		### v1.0.19
		- 音频开始正常播放后清除自动续播提示并恢复曲库状态
		### v1.0.18
		- 修复动态磁贴关闭键和折叠箭头在深色主题下变黑
		- 关闭磁贴恢复为仅在 Unraid 磁贴管理模式动态显示
		- 播放前自动唤醒本地磁盘，远程挂载等待存储就绪
		- 歌词同步由高频逐帧更新改为 250ms 低负载更新
		- 曲库扫描增加两分钟缓存，手动重新扫描仍会强制刷新
		### v1.0.17
		- 音乐卡片标题图标统一为白色
		- 移除自定义刷新和本次隐藏按钮，修复 Unraid 原生折叠箭头
		- 将动态磁贴管理的关闭键归位到标题栏并与设置、折叠键对齐
		- 歌词模式复用搜索栏空间，扩大歌词可视区域并修复遮挡
		### v1.0.16
		- 修复仪表盘重绘或克隆卡片后，随机与循环按钮多次点击失效
		- 隔离按钮鼠标、触摸事件与 Unraid 卡片拖拽，兼容电脑端和移动端
		- 卡片外观改用 Unraid 原生仪表盘标题、背景、边框和控件样式
		- 右上角补充重新扫描、插件设置和隐藏卡片功能键
		- 插件、OTA、Release 与文档版本号统一使用 v1.0.16
		### v1.0.15
		- 优化随机与循环按钮状态刷新，精简曲库状态文案
		### v1.0.14
		- 增加曲目排序切换及歌词、封面徽标
		### v1.0.13
		- 统一状态栏信息图标、音源和提示文字的垂直对齐
		### v1.0.12
		- 稳定曲目与歌词面板高度，区分重扫与歌词匹配图标
		### v1.0.11
		- 增加曲库搜索、重新扫描、歌词重新匹配和缓存清理
		### v1.0.10
		- 左侧控制区保持稳定，右侧曲目与歌词区填满剩余宽度
		### v1.0.9
		- 卡片适配仪表盘两栏与三栏布局，并接入原生拖拽排序
		### v1.0.8
		- 根据实际字体宽度优化曲目与歌词面板尺寸
		### v1.0.7
		- 增加仪表盘位置服务端记忆
		### v1.0.6
		- 修复空曲库和未配置提示重复显示
		### v1.0.5
		- 开机优先从闪存恢复插件，离线或网络超时不再丢失
		### v1.0.4
		- 加强歌词匹配校验并隔离错误歌词文件
		### v1.0.3
		- 修正歌词时间轴与偏移处理
		### v1.0.2
		- 修复曲目与歌词切换遮挡及歌词同步
		### v1.0.1
		- 优化双栏布局、歌词滚动、卡片位置和移动端按钮
		### v1.0.0
		- 首个正式版：独立音乐插件、电脑与手机配置、卡片与胶囊模式
		]]>
		</CHANGES>

<!-- Prepare dirs -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p &flash;/assets &plugdir;/assets
echo "Theme Music: preparing &name;…"
exit 0
</INLINE>
</FILE>

<!-- README shown in plugin manager -->
<FILE Name="&plugdir;/README.md">
<INLINE>
<![CDATA[
**主题音乐（Theme Music）**
				## v1.0.19 - 2026-07-31
				
				### 概述
				
				**主题音乐**独立插件。从 ThemeEffects 抽取音乐组件，以 `theme.music` 发布；路径、配置、缓存与主题特效完全分离。
				
				### 本版变更
				
				- 音频开始正常播放后清除“正在尝试自动续播”提示
				- 播放期间恢复显示正常曲库数量状态
			]]>
</INLINE>
</FILE>

<!-- Boot/install: restore runtime from flash first (offline-safe), then OTA if network works -->
<FILE Name="/tmp/theme-music-install.sh" Run="/bin/bash">
<INLINE>
#!/bin/bash
# Never hard-fail boot when flash already has a package (reboot offline / GitHub timeout).
set +e
export PATH="/usr/local/sbin:/usr/sbin:/sbin:/usr/local/bin:/usr/bin:/bin"
FLASH="&flash;"
PLUG="&plugdir;"
mkdir -p "$FLASH/assets" "$PLUG/assets"

restore_from_flash() {
  [ -f "$FLASH/ThemeMusic.page" ] || return 1
  [ -f "$FLASH/ucwc-music-api.php" ] || return 1
  echo "Theme Music: restoring runtime from flash…"
  for f in ThemeMusic.page ThemeMusic_Loader.page ucwc-music-api.php theme-music-save.php theme-music-update.php; do
    [ -f "$FLASH/$f" ] &amp;&amp; install -m 0644 "$FLASH/$f" "$PLUG/$f"
  done
  for f in ucwc-music.js ucwc-music.css theme-music-settings.js theme-music-settings.css; do
    [ -f "$FLASH/assets/$f" ] &amp;&amp; install -m 0644 "$FLASH/assets/$f" "$PLUG/assets/$f"
  done
  return 0
}

if restore_from_flash; then
  echo "Theme Music: flash restore OK"
else
  echo "Theme Music: no complete flash package yet; will need network install"
fi

URL="&installSH;"
OUT="/tmp/theme-music-install-run.sh"
echo "Theme Music: fetching install.sh for OTA &ver;…"
ok=0
if curl -4 -fsSL --http1.1 --connect-timeout 12 --max-time 45 --retry 2 -o "$OUT" "$URL"; then
  ok=1
else
  for m in \
    "https://cdn.jsdelivr.net/gh/&github;@main/scripts/install.sh" \
    "https://fastly.jsdelivr.net/gh/&github;@main/scripts/install.sh" \
    "https://raw.gitmirror.com/&github;/main/scripts/install.sh" \
    "https://ghfast.top/https://raw.githubusercontent.com/&github;/main/scripts/install.sh"
  do
    if curl -4 -fsSL --http1.1 --connect-timeout 12 --max-time 45 --retry 1 -o "$OUT" "$m"; then ok=1; break; fi
  done
fi

if [ "$ok" = "1" ] &amp;&amp; [ -s "$OUT" ]; then
  chmod +x "$OUT"
  export UCWC_PLUGIN_INSTALL=1
  # Prefer line-buffered progress for plugin manager
  if command -v stdbuf >/dev/null 2>&amp;1; then
    stdbuf -oL -eL sh "$OUT" install "&ver;" ota
  else
    sh "$OUT" install "&ver;" ota
  fi
  rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "Theme Music: OTA install OK (&ver;)"
    exit 0
  fi
  echo "Theme Music: OTA returned $rc — falling back to flash restore"
  restore_from_flash
else
  echo "Theme Music: cannot download install.sh (network)"
fi

if [ -f "$PLUG/ThemeMusic.page" ] &amp;&amp; [ -f "$PLUG/ucwc-music-api.php" ]; then
  echo "Theme Music: runtime present after offline/OTA path — boot OK"
  exit 0
fi
echo "Theme Music: ERROR — no runtime files (flash empty and network failed)" >&amp;2
exit 1
</INLINE>
</FILE>

<!-- remove -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
#!/bin/bash
SH="/tmp/theme-music-install-run.sh"
if [ ! -f "$SH" ]; then
  curl -4 -fsSL --http1.1 -o "$SH" "&installSH;" 2>/dev/null || true
fi
if [ -f "$SH" ]; then
  chmod +x "$SH" 2>/dev/null || true
  bash -c "source '$SH'; uninstall_plugin" 2>/dev/null || true
fi
rm -f /tmp/theme-music-install.sh /tmp/theme-music-install-run.sh
exit 0
</INLINE>
</FILE>

</PLUGIN>
